{
  "hosting": {
    "public": "docs",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "scratch/**", "BACKUP_*.zip"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }] },
      { "source": "firebase-bridge.js", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }] }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "database": {
    "rules": "firebase-rtdb.rules.json"
  }
}
